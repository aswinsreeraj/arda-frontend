# ARDA API Gateway base URL (relative URL utilizes Vite proxy in dev)
VITE_API_BASE_URL=/api/v1

# ARDA WebSocket Gateway URL for live telemetry & queue events
VITE_WS_URL=ws://localhost:8080/ws

# App environment
VITE_APP_ENV=development

# Platform version shown in brand headers
VITE_APP_VERSION=v0.9 beta
